<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════
         هوية Date ERP البصرية (Onyx Classic — إصدار راقي):
         كحلي عميق #0A246A | ذهبي #C9A227 | أخضر نخيلي #14532D | بيج دافئ #F1F5F9
         نظام الثيم المركزي: جميع الألوان والخطوط والأحجام قابلة للتخصيص
         من شاشة واحدة عبر ThemeManager - بدون تعديل XAML
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ═══ الألوان الأساسية (قابلة للتخصيص) ═══ -->
    <Color x:Key="PrimaryColor">#14532D</Color>
    <Color x:Key="PrimaryDarkColor">#0B3D1F</Color>
    <Color x:Key="SecondaryColor">#C9A227</Color>
    <Color x:Key="AccentColor">#C9A227</Color>
    <Color x:Key="LightBgColor">#F1F5F9</Color>
    <Color x:Key="BackgroundColor">#F1F5F9</Color>
    <Color x:Key="WindowBgColor">#F1F5F9</Color>
    <Color x:Key="SurfaceColor">#F8FAFC</Color>
    <Color x:Key="ScreenBackgroundColor">#F1F5F9</Color>
    <Color x:Key="PageHeaderBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ChromeBackgroundColor">#0A246A</Color>
    <Color x:Key="SidebarBackgroundColor">#0F172A</Color>
    <Color x:Key="BorderColor">#94A3B8</Color>
    <Color x:Key="LineColor">#CBD5E1</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="NavyColor">#0A246A</Color>
    <Color x:Key="TextPrimaryColor">#1E293B</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <Color x:Key="ButtonBackgroundColor">#F8FAFC</Color>
    <Color x:Key="ButtonForegroundColor">#1F2937</Color>
    <Color x:Key="ButtonHoverColor">#FEF9EC</Color>
    <Color x:Key="ButtonPressedColor">#E2E8F0</Color>
    <Color x:Key="PrimaryButtonBackgroundColor">#0A246A</Color>
    <Color x:Key="PrimaryButtonForegroundColor">#FFFFFF</Color>
    <Color x:Key="PrimaryButtonHoverColor">#123A8F</Color>
    <Color x:Key="ButtonTextColor">#1F2937</Color>

    <!-- ألوان دلالية موحّدة -->
    <Color x:Key="ErpSurfaceColor">#F8FAFC</Color>
    <Color x:Key="ErpInkColor">#1E293B</Color>
    <Color x:Key="ErpMutedColor">#64748B</Color>
    <Color x:Key="ErpLineColor">#CBD5E1</Color>
    <Color x:Key="ErpOkColor">#15803D</Color>
    <Color x:Key="ErpWarnColor">#B45309</Color>
    <Color x:Key="ErpDangerColor">#B91C1C</Color>
    <Color x:Key="ErpInfoColor">#0284C7</Color>
    <Color x:Key="InvalidRowColor">#FECACA</Color>
    <Color x:Key="AuxWarningLightColor">#FEF9C7</Color>
    <Color x:Key="DarkTitleColor">#123544</Color>
    <Color x:Key="MutedTextColor">#526474</Color>
    <Color x:Key="LightMutedColor">#6B7280</Color>
    <Color x:Key="SuccessLightColor">#DCFCE7</Color>
    <Color x:Key="WarningColor">#B45309</Color>
    <Color x:Key="WarningLightColor">#FEF3C7</Color>
    <Color x:Key="ErrorColor">#B91C1C</Color>
    <Color x:Key="ErrorLightColor">#FEE2E2</Color>
    <Color x:Key="InfoColor">#0284C7</Color>
    <Color x:Key="InfoLightColor">#E0F2FE</Color>

    <!-- ألوان الجداول -->
    <Color x:Key="TableBackgroundColor">#FFFFFF</Color>
    <Color x:Key="TableHeaderBackgroundColor">#0A246A</Color>
    <Color x:Key="TableHeaderForegroundColor">#FFFFFF</Color>
    <Color x:Key="TableRowColor">#FFFFFF</Color>
    <Color x:Key="TableAlternateRowColor">#F8FAFC</Color>
    <Color x:Key="TableSelectedRowColor">#FEF3C7</Color>
    <Color x:Key="TableHoverRowColor">#E8EEF7</Color>
    <Color x:Key="TableSelectedCellColor">#C9A227</Color>

    <!-- ═══ الفرش (Brushes) - تستخدم DynamicResource للألوان ═══ -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{DynamicResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{DynamicResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="LightBgBrush" Color="{DynamicResource LightBgColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}"/>
    <SolidColorBrush x:Key="WindowBgBrush" Color="{DynamicResource WindowBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
    <SolidColorBrush x:Key="ScreenBackgroundBrush" Color="{DynamicResource ScreenBackgroundColor}"/>
    <SolidColorBrush x:Key="PageHeaderBackgroundBrush" Color="{DynamicResource PageHeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="{DynamicResource ChromeBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{DynamicResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrushStd" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource LineColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="NavyBrush" Color="{DynamicResource NavyColor}"/>
    <SolidColorBrush x:Key="GrayTextBrush" Color="{DynamicResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource ButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{DynamicResource ButtonForegroundColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{DynamicResource ButtonHoverColor}"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{DynamicResource ButtonPressedColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{DynamicResource PrimaryButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{DynamicResource PrimaryButtonForegroundColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="{DynamicResource PrimaryButtonHoverColor}"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="{DynamicResource ButtonTextColor}"/>

    <SolidColorBrush x:Key="ErpSurfaceBrush" Color="{DynamicResource ErpSurfaceColor}"/>
    <SolidColorBrush x:Key="ErpInkBrush" Color="{DynamicResource ErpInkColor}"/>
    <SolidColorBrush x:Key="ErpMutedBrush" Color="{DynamicResource ErpMutedColor}"/>
    <SolidColorBrush x:Key="ErpLineBrush" Color="{DynamicResource ErpLineColor}"/>
    <SolidColorBrush x:Key="ErpOkBrush" Color="{DynamicResource ErpOkColor}"/>
    <SolidColorBrush x:Key="ErpWarnBrush" Color="{DynamicResource ErpWarnColor}"/>
    <SolidColorBrush x:Key="ErpDangerBrush" Color="{DynamicResource ErpDangerColor}"/>
    <SolidColorBrush x:Key="ErpInfoBrush" Color="{DynamicResource ErpInfoColor}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{DynamicResource SuccessLightColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{DynamicResource WarningLightColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{DynamicResource ErrorLightColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{DynamicResource InfoLightColor}"/>
    <SolidColorBrush x:Key="InvalidRowBrush" Color="{DynamicResource InvalidRowColor}"/>
    <SolidColorBrush x:Key="AuxWarningLightBrush" Color="{DynamicResource AuxWarningLightColor}"/>
    <SolidColorBrush x:Key="DarkTitleBrush" Color="{DynamicResource DarkTitleColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="LightMutedBrush" Color="{DynamicResource LightMutedColor}"/>

    <SolidColorBrush x:Key="TableBackgroundBrush" Color="{DynamicResource TableBackgroundColor}"/>
    <SolidColorBrush x:Key="TableHeaderBackgroundBrush" Color="{DynamicResource TableHeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="TableHeaderForegroundBrush" Color="{DynamicResource TableHeaderForegroundColor}"/>
    <SolidColorBrush x:Key="TableRowBrush" Color="{DynamicResource TableRowColor}"/>
    <SolidColorBrush x:Key="TableAlternateRowBrush" Color="{DynamicResource TableAlternateRowColor}"/>
    <SolidColorBrush x:Key="TableSelectedRowBrush" Color="{DynamicResource TableSelectedRowColor}"/>
    <SolidColorBrush x:Key="TableHoverRowBrush" Color="{DynamicResource TableHoverRowColor}"/>
    <SolidColorBrush x:Key="TableSelectedCellBrush" Color="{DynamicResource TableSelectedCellColor}"/>

    <!-- ═══ الخطوط (قابلة للتخصيص) ═══ -->
    <FontFamily x:Key="HeadFont">Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="MainFontFamily">Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Segoe UI, Tahoma, Arial</FontFamily>
    <system:Double x:Key="UiFontSize">12.5</system:Double>
    <system:Double x:Key="BaseFontSize">12.5</system:Double>
    <system:Double x:Key="PageTitleFontSize">18</system:Double>
    <system:Double x:Key="SectionTitleFontSize">15</system:Double>
    <system:Double x:Key="TableFontSize">12.5</system:Double>
    <system:Double x:Key="TableHeaderFontSize">12</system:Double>
    <system:Double x:Key="ButtonFontSize">12</system:Double>
    <system:Double x:Key="FieldLabelFontSize">12</system:Double>

    <FontWeight x:Key="HeadingFontWeight">Bold</FontWeight>
    <FontWeight x:Key="BodyFontWeight">Normal</FontWeight>
    <system:Boolean x:Key="IsHeadingBold">True</system:Boolean>
    <system:Boolean x:Key="IsBodyBold">False</system:Boolean>
    <system:Boolean x:Key="IsButtonBold">True</system:Boolean>

    <!-- ═══ الأحجام والزوايا (قابلة للتخصيص) ═══ -->
    <system:Double x:Key="BorderThicknessValue">1.2</system:Double>
    <system:Double x:Key="TextBoxBorderThicknessValue">1.2</system:Double>
    <system:Double x:Key="ButtonBorderThicknessValue">1.2</system:Double>
    <system:Double x:Key="TableBorderThicknessValue">1</system:Double>

    <CornerRadius x:Key="CornerRadiusValue">6</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadiusValue">6</CornerRadius>
    <CornerRadius x:Key="TextBoxCornerRadiusValue">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadiusValue">8</CornerRadius>

    <system:Double x:Key="CornerRadiusDouble">6</system:Double>
    <system:Double x:Key="ButtonCornerRadiusDouble">6</system:Double>
    <system:Double x:Key="TextBoxCornerRadiusDouble">4</system:Double>
    <system:Double x:Key="CardCornerRadiusDouble">8</system:Double>

    <system:Double x:Key="ButtonHeight">30</system:Double>
    <system:Double x:Key="ButtonMinWidth">92</system:Double>
    <system:Double x:Key="ButtonIconSize">14</system:Double>
    <system:Double x:Key="TitleBarHeight">40</system:Double>
    <system:Double x:Key="ContentPaddingValue">12</system:Double>
    <system:Double x:Key="SidebarWidthValue">260</system:Double>
    <system:Double x:Key="ShadowDepthValue">1</system:Double>
    <system:Double x:Key="ShadowBlurValue">8</system:Double>
    <system:Double x:Key="ShadowOpacityValue">0.12</system:Double>
    <system:Double x:Key="TableRowHeight">32</system:Double>
    <system:Double x:Key="TableHeaderHeight">32</system:Double>
    <system:Double x:Key="FieldPaddingValue">6</system:Double>
    <system:Double x:Key="OverallOpacity">1</system:Double>

    <Thickness x:Key="FieldPaddingThickness">6,4</Thickness>
    <Thickness x:Key="ButtonPaddingValue">14,6,14,6</Thickness>
    <Thickness x:Key="ContentPaddingThickness">12</Thickness>

    <system:Boolean x:Key="ShowUnderline">False</system:Boolean>
    <system:Boolean x:Key="ShowTextBoxBorder">True</system:Boolean>
    <system:Boolean x:Key="ShowButtonBorder">True</system:Boolean>
    <system:Boolean x:Key="ShowSidebar">True</system:Boolean>
    <system:Boolean x:Key="EnableShadow">True</system:Boolean>
    <system:Boolean x:Key="CardHasShadow">True</system:Boolean>
    <system:Boolean x:Key="ButtonHasShadow">False</system:Boolean>
    <system:Boolean x:Key="IsDarkMode">False</system:Boolean>
    <system:Boolean x:Key="TableShowGridLines">True</system:Boolean>
    <system:Boolean x:Key="TableShowColumnSeparators">True</system:Boolean>
    <system:Boolean x:Key="TableShowRowSeparators">True</system:Boolean>
    <system:Boolean x:Key="TableShowRowNumbers">False</system:Boolean>
    <system:Boolean x:Key="TableAlternateRows">True</system:Boolean>
    <system:Boolean x:Key="TableEnableHover">True</system:Boolean>

    <system:String x:Key="InputShape">Rounded</system:String>
    <system:String x:Key="ButtonShape">Rounded</system:String>
    <system:String x:Key="ButtonStyle">Default</system:String>
    <system:String x:Key="CardShape">Rounded</system:String>
    <system:String x:Key="SidebarShape">Default</system:String>
    <system:String x:Key="TableTextAlignment">Right</system:String>
    <system:String x:Key="TableHeaderAlignment">Center</system:String>
    <system:String x:Key="ButtonIconPosition">Left</system:String>

    <!-- ═══ النوافذ: خلفية موحدة وخط موحد ═══ -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBgBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ═══ معيار الجداول الموحد ═══ -->
    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource TableFontSize}"/>
        <Setter Property="Background" Value="{DynamicResource TableBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStd}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource TableBorderThicknessValue}"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ErpLineBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource LightBgBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="{DynamicResource TableRowHeight}"/>
        <Setter Property="ColumnHeaderHeight" Value="{DynamicResource TableHeaderHeight}"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource TableHeaderBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TableHeaderForegroundBrush}"/>
                    <Setter Property="FontWeight" Value="{DynamicResource HeadingFontWeight}"/>
                    <Setter Property="FontSize" Value="{DynamicResource TableHeaderFontSize}"/>
                    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStd}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TableSelectedCellBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="AlternationIndex" Value="1">
                            <Setter Property="Background" Value="{DynamicResource TableAlternateRowBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TableHoverRowBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TableSelectedRowBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ معيار الحقول الموحد ═══ -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="{DynamicResource FieldPaddingThickness}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource TextBoxBorderThicknessValue}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStd}"/>
        <Setter Property="Background" Value="{DynamicResource TableBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" Text="⚠"
                                   ToolTip="{Binding ElementName=adorner, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"/>
                        <Border BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1.5" CornerRadius="2">
                            <AdornedElementPlaceholder x:Name="adorner"/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="1.8"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource LightBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStd}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource TableBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStd}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource TableBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStd}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource TableBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStd}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource TableBackgroundBrush}"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TableHoverRowBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ أزرار واضحة مشبعة ═══ -->
    <Style x:Key="ErpButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="{DynamicResource ButtonPaddingValue}"/>
        <Setter Property="Margin" Value="3,2"/>
        <Setter Property="MinHeight" Value="{DynamicResource ButtonHeight}"/>
        <Setter Property="MinWidth" Value="{DynamicResource ButtonMinWidth}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStd}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource ButtonBorderThicknessValue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="{DynamicResource ButtonCornerRadiusValue}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="{Binding Source={DynamicResource TableBackgroundColor}}" Offset="0"/>
                                <GradientStop Color="{Binding Source={DynamicResource LightBgColor}}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.6"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ErpPrimaryButton" TargetType="Button" BasedOn="{StaticResource ErpButton}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDarkColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="{DynamicResource ButtonCornerRadiusValue}"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource PrimaryButtonBackgroundBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ErpApproveButton" TargetType="Button" BasedOn="{StaticResource ErpButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ErpOkColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="{DynamicResource ButtonCornerRadiusValue}"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource ErpOkBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="#22C55E"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ErpDangerButton" TargetType="Button" BasedOn="{StaticResource ErpButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#7F1D1D"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="{DynamicResource ButtonCornerRadiusValue}"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource ErpDangerBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#FCA5A5"/>
                            <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#7F1D1D"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ErpPrimaryButton}"/>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ErpButton}"/>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ErpDangerButton}"/>

    <Style x:Key="ErpChromeButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2B4C8C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#061845"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ErpChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ErpChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#7F1D1D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

