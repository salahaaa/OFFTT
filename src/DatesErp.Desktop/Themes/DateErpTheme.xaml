    <Style x:Key="SecHeader" TargetType="Border">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Background" Value="{DynamicResource ErpSurfaceBrush}"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TableBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ErpLineBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessValue}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadiusValue}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="{DynamicResource ShadowDepthValue}" BlurRadius="{DynamicResource ShadowBlurValue}" Opacity="{DynamicResource ShadowOpacityValue}" Color="#0F172A"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WhiteCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TableBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ErpLineBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessValue}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadiusValue}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="{DynamicResource ShadowDepthValue}" BlurRadius="{DynamicResource ShadowBlurValue}" Opacity="0.10" Color="#0F172A"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="#CBD5E1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,1" CornerRadius="6">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#40CA8A04"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#CA8A04"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            <Setter Property="Foreground" Value="#FEF08A"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource TableHeaderForegroundBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="{DynamicResource TableHeaderFontSize}"/>
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStd}"/>
