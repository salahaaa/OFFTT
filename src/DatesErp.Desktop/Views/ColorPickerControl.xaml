<UserControl x:Class="DatesErp.Desktop.Views.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <!-- معاينة اللون -->
        <Border x:Name="ColorPreview" Grid.Column="0" Width="32" Height="24" 
                CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1" Margin="0,0,6,0"
                Cursor="Hand" MouseLeftButtonUp="ColorPreview_Click">
            <Border.Background>
                <SolidColorBrush Color="#14532D"/>
            </Border.Background>
        </Border>
        
        <!-- حقل إدخال Hex -->
        <TextBox x:Name="HexBox" Grid.Column="1" Text="#14532D" 
                 VerticalContentAlignment="Center" MinHeight="28"
                 TextChanged="HexBox_TextChanged"/>
        
        <!-- زر اختيار -->
        <Button Grid.Column="2" Content="🎨" Width="32" Height="28" Margin="4,0,0,0"
                Style="{DynamicResource ErpButton}" Click="PickerButton_Click"/>
        
        <!-- Popup للألوان -->
        <Popup x:Name="ColorPopup" Placement="Bottom" StaysOpen="False" 
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1" 
                    CornerRadius="6" Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="اختر اللون:" FontWeight="Bold" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="PresetColorsPanel" Width="200"/>
                    <Separator Margin="0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="مخصص:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="CustomHexBox" Width="100" Text="#14532D"/>
                        <Button Content="تطبيق" Margin="6,0,0,0" Padding="8,2"
                                Style="{DynamicResource ErpPrimaryButton}"
                                Click="ApplyCustom_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
