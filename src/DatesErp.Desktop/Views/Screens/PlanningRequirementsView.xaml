<UserControl x:Class="DatesErp.Desktop.Views.Screens.PlanningRequirementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock Text="التخطيط والإنتاج" FontSize="25" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}"/>
                    <TextBlock Text="تخطيط احتياجات الخامات ومتابعة المتاح قبل بدء خطة الإنتاج" FontSize="12" Foreground="{StaticResource ErpMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⋮" Style="{StaticResource ErpButton}" Width="42" Margin="0,0,8,0"/>
                    <Button x:Name="RefreshButton" Content="⟳ تحديث البيانات" Style="{StaticResource ErpPrimaryButton}" Click="Refresh_Click"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="المنتج النهائي" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FinishedProductBox" DisplayMemberPath="ProductNameAr" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="المستودع" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="WarehouseBox" DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="رقم التشغيل / الدفعة" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="LotBox" DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="نطاق التخطيط" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <DatePicker x:Name="FromDate" Grid.Column="0" SelectedDateChanged="Date_Changed"/>
                            <TextBlock Grid.Column="1" Text="إلى" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                            <DatePicker x:Name="ToDate" Grid.Column="2" SelectedDateChanged="Date_Changed"/>
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="4" Content="فتح إعداد الخطة" Style="{StaticResource ErpButton}" Click="OpenPlanEditor_Click" VerticalAlignment="Bottom" Padding="14,7"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource ErpSurfaceBrush}" BorderBrush="{StaticResource BorderBrushStd}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="📊 احتياجات الخامات" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock x:Name="SummaryText" Text="—" Foreground="{StaticResource MutedTextBrush}" Margin="14,0,0,0"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,10,12,8">
                        <TextBlock DockPanel.Dock="Right" Text="احتياجات الخامات" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="📤 تصدير Excel" Style="{StaticResource ErpButton}" Click="Export_Click" Margin="0,0,6,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="RequirementsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="38" FontSize="13" ColumnHeaderHeight="42"
                              AlternatingRowBackground="{StaticResource ErpSurfaceBrush}" Background="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource ErpLineBrush}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="Background" Value="{StaticResource InvalidRowBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الخامة" Binding="{Binding RawName}" Width="1.4*"/>
                            <DataGridTextColumn Header="المخزون الفعلي (كجم)" Binding="{Binding Actual, StringFormat=N0}" Width="1.1*"/>
                            <DataGridTextColumn Header="مخصص للخطط السابقة (كجم)" Binding="{Binding Reserved, StringFormat=N0}" Width="1.2*"/>
                            <DataGridTextColumn Header="التزامات تشغيلية أخرى (كجم)" Binding="{Binding Other, StringFormat=N0}" Width="1.2*"/>
                            <DataGridTextColumn Header="تحت المعالجة (كجم)" Binding="{Binding UnderTreatment, StringFormat=N0}" Width="1*"/>
                            <DataGridTextColumn Header="المتاح للتخطيط (كجم)" Binding="{Binding Available, StringFormat=N0}" Width="1.1*"/>
                            <DataGridTextColumn Header="احتياج الخام المحسوب (كجم)" Binding="{Binding Required, StringFormat=N0}" Width="1.2*"/>
                            <DataGridTextColumn Header="المتبقي بعد (كجم)" Binding="{Binding Remaining, StringFormat=N0}" Width="1.1*"/>
                            <DataGridTemplateColumn Header="الحالة" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Center" Background="{Binding StatusBackground}">
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="{Binding StatusForeground}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
