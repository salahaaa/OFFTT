                            <!-- أزرار -->
                            <TextBlock Text="الأزرار:" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="💾 حفظ" Style="{StaticResource ErpPrimaryButton}" Margin="0,0,6,6"/>
                                <Button Content="إلغاء" Style="{StaticResource ErpButton}" Margin="0,0,6,6"/>
                                <Button Content="✅ اعتماد" Style="{StaticResource ErpApproveButton}" Margin="0,0,6,6"/>
                                <Button Content="🗑️ حذف" Style="{StaticResource ErpDangerButton}" Margin="0,0,6,6"/>
                            </WrapPanel>

                            <!-- جدول -->
                            <TextBlock Text="جدول:" Style="{StaticResource FieldLabel}"/>
                            <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" Height="120" Margin="0,0,0,12"
                                      HeadersVisibility="Column" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="م" Binding="{Binding No}" Width="40"/>
                                    <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="الكمية" Binding="{Binding Qty}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- بطاقة -->
                            <TextBlock Text="بطاقة:" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="عنوان البطاقة" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="محتوى البطاقة التجريبي يوضح شكل البطاقات في النظام بعد التخصيص." 
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- رسائل حالات -->
                            <TextBlock Text="رسائل الحالات:" Style="{StaticResource FieldLabel}"/>
                            <Border Background="{DynamicResource SuccessLightBrush}" BorderBrush="{DynamicResource SuccessBrush}" 
                                    BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" Margin="0,0,6,0"/>
                                    <TextBlock Text="تمت العملية بنجاح" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource WarningLightBrush}" BorderBrush="{DynamicResource WarningBrush}" 
                                    BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" Margin="0,0,6,0"/>
                                    <TextBlock Text="تحذير: راجع البيانات" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource ErrorLightBrush}" BorderBrush="{DynamicResource ErrorBrush}" 
                                    BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❌" Margin="0,0,6,0"/>
                                    <TextBlock Text="خطأ: فشلت العملية" Foreground="{DynamicResource ErrorBrush}" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource InfoLightBrush}" BorderBrush="{DynamicResource InfoBrush}" 
                                    BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ℹ️" Margin="0,0,6,0"/>
                                    <TextBlock Text="معلومة: تم التحديث" Foreground="{DynamicResource InfoBrush}" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- نصوص -->
                            <TextBlock Text="النصوص:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="نص رئيسي - Primary Text" FontSize="{DynamicResource BaseFontSize}" Margin="0,0,0,4"/>
                            <TextBlock Text="نص ثانوي - Secondary Text" FontSize="{DynamicResource BaseFontSize}" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ شريط سفلي ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource ErpSurfaceColor}" BorderBrush="{DynamicResource ErpLineColor}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="جاهز - اختر فئة للتخصيص" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="آخر حفظ:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="LastSavedText" Text="—" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
