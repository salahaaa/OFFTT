<UserControl x:Class="DatesErp.Desktop.Views.Screens.WarehouseTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <DockPanel LastChildFill="True">
        <!-- رأس السند -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                    <TextBlock Text="🔄 تحويل مخزني — من مخزن مصدر إلى مخزن مستلم (تعدد المخازن)" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                </Border>
                <WrapPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="من: المخزن المصدر *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="SourceWhBox" Width="220" DisplayMemberPath="WarehouseNameAr" SelectedValuePath="Id" SelectionChanged="SourceWh_Changed"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="إلى: المخزن المستلم *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DestWhBox" Width="220" DisplayMemberPath="WarehouseNameAr" SelectedValuePath="Id"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="تاريخ التحويل:" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DateBox" Width="150"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="رقم السند (تلقائي):" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DocNoBox" Width="170" IsReadOnly="True" Background="#F0F0F0"/>
                    </StackPanel>
                    <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,6" VerticalAlignment="Bottom" Margin="0,0,16,0">
                        <TextBlock x:Name="BalanceChip" Text="الرصيد: —" FontWeight="Bold" FontSize="12" Foreground="#1E40AF"/>
                    </Border>
                </WrapPanel>
                <TextBlock Text="ملاحظات:" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                <TextBox x:Name="NotesBox" MinHeight="30" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- الرصيد حسب المخزن -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="📊 الرصيد في المخزن المصدر — الصنف + المخزن + الدفعة" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="➕ إضافة من الرصيد" Style="{StaticResource ErpButton}" Click="AddFromBalance_Click"/>
                            <Button Content="⬇ تحويل كامل الرصيد" Style="{StaticResource ErpButton}" Click="TransferAll_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DataGrid x:Name="BalanceGrid" Height="140" RowHeight="28" MouseDoubleClick="Balance_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="120"/>
                        <DataGridTextColumn Header="الصنف/المادة" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="110"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="120"/>
                        <DataGridTextColumn Header="الرصيد (كجم)" Binding="{Binding QtyKg}" Width="100"/>
                        <DataGridTextColumn Header="العبوات" Binding="{Binding PackageCount}" Width="80"/>
                        <DataGridTextColumn Header="العبوة" Binding="{Binding PackagingName}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="نقر مزدوج على سطر الرصيد لإضافته إلى بنود التحويل" FontSize="11" Foreground="#555" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- بنود التحويل -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="📋 بنود التحويل المخزني" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="➕ صف جديد" Style="{StaticResource ErpButton}" Click="AddEmptyRow_Click"/>
                            <Button Content="🗑 حذف السطر" Style="{StaticResource ErpDangerButton}" Click="RemoveRow_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DataGrid x:Name="ItemsGrid" Height="160" MinHeight="120" RowHeight="34" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="الصنف *" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ProductName}" Click="Product_Click" Tag="{Binding}" Style="{StaticResource ErpButton}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="المتاح (كجم)" Binding="{Binding AvailableQty}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الكمية (كجم) *" Binding="{Binding QtyKg, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="العبوات" Binding="{Binding PackageCount, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="150"/>
                        <DataGridTemplateColumn Header="حذف" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Style="{StaticResource ErpDangerButton}" Click="RemoveItem_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- سجل التحويلات -->
        <Border Style="{StaticResource WhiteCard}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="سندات التحويل المخزني (نقر مزدوج للفتح)" FontWeight="Bold" FontSize="12" Foreground="#0A246A" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🔍 بحث:" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchBox" Width="340" TextChanged="Search_Changed" VerticalAlignment="Center"/>
                </StackPanel>
                <DataGrid x:Name="TransfersGrid" RowHeight="30" FontSize="13.5" ColumnHeaderHeight="38" MouseDoubleClick="TransfersGrid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding DocNo}" Width="130"/>
                        <DataGridTextColumn Header="من مخزن" Binding="{Binding SourceWh}" Width="140"/>
                        <DataGridTextColumn Header="إلى مخزن" Binding="{Binding DestWh}" Width="140"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="110"/>
                        <DataGridTextColumn Header="الإجمالي (كجم)" Binding="{Binding Qty}" Width="110"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
