<UserControl x:Class="DatesErp.Desktop.Views.Screens.FinishedGoodsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- §تسليم الإنتاج للمخازن — شاشة تشغيلية: أمر إنتاج (بحث) ← ملخص ← جدول التام ← جدول المخرجات الثانوية ← ملخص السند -->
    <DockPanel LastChildFill="True">

        <!-- ═══ رأس السند + اختيار أمر الإنتاج ═══ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,6">
            <StackPanel>
                <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="📦 سند تسليم الإنتاج للمخازن" Style="{StaticResource SectionTitle}"/>
                        <Border x:Name="StatusBadge" DockPanel.Dock="Left" Style="{StaticResource StatusBadge}" Margin="8,0,0,0">
                            <TextBlock x:Name="StatusText" Text="جديد" Style="{StaticResource StatusText}"/>
                        </Border>
                    </DockPanel>
                </Border>
                <WrapPanel>
                    <StackPanel Margin="0,0,14,4">
                        <TextBlock Text="رقم السند:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DocNoBox" Width="140" IsReadOnly="True" Background="{StaticResource LightBgBrush}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,4">
                        <TextBlock Text="تاريخ التسليم:" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DateBox" Width="140"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,4">
                        <TextBlock Text="أمر الإنتاج:" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button x:Name="PickOrderBtn" DockPanel.Dock="Left" Content="🔍 اختيار أمر إنتاج" Style="{StaticResource ErpPrimaryButton}" Click="PickOrder_Click" Margin="6,0,0,0"
                                    ToolTip="بحث برقم الأمر أو العميل أو الصنف — يعرض المخطط/الفعلي/المسلَّم/المتبقي لكل أمر"/>
                            <TextBox x:Name="OrderNoBox" Width="170" IsReadOnly="True" Background="{StaticResource LightBgBrush}" ToolTip="أمر الإنتاج المختار"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,4">
                        <TextBlock Text="رقم الاستلام:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ReceiptNoBox" Width="120" IsReadOnly="True" Background="{StaticResource LightBgBrush}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="ملاحظات السند:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NotesBox" Width="300" MaxLength="500"/>
                    </StackPanel>
                </WrapPanel>
                <!-- ملخص أمر الإنتاج -->
                <Border Style="{StaticResource WhiteCard}" Margin="0,6,0,0" Padding="8,4">
                    <WrapPanel>
                        <TextBlock Text="📋 " FontWeight="Bold"/>
                        <TextBlock x:Name="SumPlan" Text="الخطة: —" Margin="0,0,16,0"/>
                        <TextBlock x:Name="SumDate" Text="التاريخ: —" Margin="0,0,16,0"/>
                        <TextBlock x:Name="SumShift" Text="الوردية: —" Margin="0,0,16,0"/>
                        <TextBlock x:Name="SumLine" Text="الخط: —" Margin="0,0,16,0"/>
                        <TextBlock x:Name="SumCustomers" Text="العملاء: —" Margin="0,0,16,0" FontWeight="Bold"/>
                        <TextBlock x:Name="SumOrderStatus" Text="حالة الأمر: —" Margin="0,0,16,0"/>
                        <TextBlock x:Name="SumTotals" Text="الفعلي: — | المسلَّم: — | المتبقي: —" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ ملخص السند + تنبيهات (أسفل) ═══ -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,6,0,0" Padding="10,6">
            <DockPanel>
                <TextBlock x:Name="DocTotals" DockPanel.Dock="Right" Text="إجمالي التسليم: 0 كرتون / 0 كجم — 0 بند" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                <TextBlock x:Name="HintText" Text="ابدأ بـ «جديد» ثم «اختيار أمر إنتاج» — تظهر فقط الأوامر التي لها إنتاج فعلي مسجَّل." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>

        <!-- ═══ جدول المخرجات الثانوية (أسفل الوسط) ═══ -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,6,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SecHeader}" Margin="-12,-12,-12,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="♻ المخرجات الثانوية والمخلفات — تُقرأ من إقفال اليوم؛ تُقيَّد مخزنياً عند وجود صنف مطابق (مجموعة 003) وإلا تُوثَّق في السند" Style="{StaticResource SectionTitle}"/>
                        <Button x:Name="AddByProductBtn" DockPanel.Dock="Left" Content="➕ إضافة صف" Style="{StaticResource ErpButton}" Click="AddByProduct_Click" ToolTip="إضافة مخرج ثانوي مسجَّل له متبقٍ غير مسلَّم"/>
                    </DockPanel>
                </Border>
                <DataGrid x:Name="ByProductsGrid" Height="118" RowHeight="28" AutoGenerateColumns="False" CanUserAddRows="False" CellEditEnding="Grid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المخرج" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding KindAr}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الفعلي المسجَّل" Binding="{Binding ProducedQty, StringFormat=N2}" Width="105" IsReadOnly="True"/>
                        <DataGridTextColumn Header="سبق تسليمه" Binding="{Binding DeliveredQty, StringFormat=N2}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingQty, StringFormat=N2}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="كمية التسليم" Binding="{Binding DeliverQty, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridComboBoxColumn x:Name="BpWarehouseCol" Header="مخزن الاستلام" SelectedValueBinding="{Binding WarehouseId, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" SelectedValuePath="Id" Width="170"/>
                        <DataGridTextColumn Header="قيد مخزني" Binding="{Binding PostsStockAr}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ═══ جدول الإنتاج التام (يملأ الوسط) ═══ -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SecHeader}" Margin="-12,-12,-12,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="🧾 الإنتاج التام — كمية التسليم لا تتجاوز المتبقي (الفعلي − سبق تسليمه)؛ مخزن إدخال لكل بند" Style="{StaticResource SectionTitle}"/>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="AllRemainingBtn" Content="⬇ تسليم كامل المتبقي" Style="{StaticResource ErpButton}" Click="AllRemaining_Click" ToolTip="يملأ كمية التسليم بالمتبقي لكل بند"/>
                            <Button x:Name="ClearQtyBtn" Content="⌫ تصفير الكميات" Style="{StaticResource ErpButton}" Click="ClearQty_Click" Margin="6,0,0,0"/>
                            <ComboBox x:Name="BulkWarehouseBox" Width="180" Margin="6,0,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="تطبيق مخزن واحد على كل البنود (قابل للتغيير لكل بند)" SelectionChanged="BulkWarehouse_Changed"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DataGrid x:Name="ItemsGrid" RowHeight="28" AutoGenerateColumns="False" CanUserAddRows="False" CellEditEnding="Grid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="العبوة / المواصفة" Binding="{Binding PackSpec}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="المخطط (كجم)" Binding="{Binding PlannedKg, StringFormat=N1}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الفعلي (كجم)" Binding="{Binding ProducedKg, StringFormat=N1}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="سبق تسليمه" Binding="{Binding DeliveredKg, StringFormat=N1}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingKg, StringFormat=N1}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="كراتين التسليم" Binding="{Binding DeliverCartons, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridTextColumn Header="كمية التسليم (كجم)" Binding="{Binding DeliverKg, StringFormat=N1}" Width="120" IsReadOnly="True"/>
                        <DataGridComboBoxColumn x:Name="WarehouseCol" Header="مخزن الإدخال" SelectedValueBinding="{Binding WarehouseId, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" SelectedValuePath="Id" Width="170"/>
                        <DataGridTextColumn Header="الرصيد بعد" Binding="{Binding BalanceAfterText}" Width="90" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
