<UserControl x:Class="DatesErp.Desktop.Views.Screens.PlanClosureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="360"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock Text="إقفال خطة الإنتاج" FontSize="25" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}"/>
                    <TextBlock Text="مراجعة أوامر الخطة وإغلاقها رسمياً بعد اكتمال التنفيذ ومعالجة الفروقات" FontSize="12" Foreground="{StaticResource ErpMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SearchPlanBtn" Content="🔍 بحث" Style="{StaticResource ErpButton}" Click="SearchPlan_Click" Margin="0,0,6,0"/>
                    <Button x:Name="AddPlanBtn" Content="+ خطة جديدة" Style="{StaticResource ErpPrimaryButton}" Click="AddPlan_Click"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="الخطة المراد إقفالها" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="PlanPickBox" Height="34" SelectionChanged="PlanPick_Changed"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="⟳ تحديث" Style="{StaticResource ErpButton}" Click="Refresh_Click" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                    <Border Grid.Column="2" Background="{StaticResource ErpSurfaceBrush}" BorderBrush="{StaticResource BorderBrushStd}" BorderThickness="1" CornerRadius="4" Padding="12,7" VerticalAlignment="Bottom">
                        <TextBlock x:Name="PlanStatusBox" Text="—" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="رقم الخطة" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="HNumber" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="النوع" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="HType" Foreground="{StaticResource ErpInkBrush}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="بداية الفترة" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="HStart" Foreground="{StaticResource ErpInkBrush}"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="نهاية الفترة" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="HEnd" Foreground="{StaticResource ErpInkBrush}"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="أُغلقت في" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="HClosedAt" Foreground="{StaticResource ErpOkBrush}"/></StackPanel>
                    <StackPanel Grid.Column="5"><TextBlock Text="بواسطة" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="HClosedBy" Foreground="{StaticResource ErpOkBrush}"/></StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="3" Columns="6" Margin="0,0,0,12">
                <Border Style="{StaticResource WhiteCard}" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="الأوامر" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="CTotalOrders" FontSize="17" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource WhiteCard}" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="مفتوحة / قيد الإنتاج" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="COpen" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ErpWarnBrush}"/><TextBlock x:Name="CInProgress" FontSize="11" Foreground="{StaticResource ErpWarnBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource WhiteCard}" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="مكتملة / مقفلة" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="CCompleted" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ErpOkBrush}"/><TextBlock x:Name="CClosed" FontSize="11" Foreground="{StaticResource ErpOkBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource WhiteCard}" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="المخطط / الفعلي" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="CPlanned" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}"/><TextBlock x:Name="CProduced" FontSize="11" Foreground="{StaticResource ErpOkBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource WhiteCard}" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="المتبقي / المعالج" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="CRemaining" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ErpWarnBrush}"/><TextBlock x:Name="CSettled" FontSize="11" Foreground="{StaticResource ErpOkBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource WhiteCard}" Padding="10"><StackPanel><TextBlock Text="أوامر غير معالجة" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="CUnprocessed" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ErpDangerBrush}"/><TextBlock x:Name="CCancelled" FontSize="11" Foreground="{StaticResource ErpMutedBrush}"/></StackPanel></Border>
            </UniformGrid>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="ReadinessBanner" Grid.Row="0" Background="{StaticResource InvalidRowBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="حالة الإقفال" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ErpDangerBrush}" Margin="0,0,16,0"/>
                        <TextBlock x:Name="ReadinessBox" Text="—" FontWeight="SemiBold" Foreground="{StaticResource ErpDangerBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel>
                                <Button x:Name="ClosePlanBtn" Content="🔒 حفظ وإقفال الخطة" Style="{StaticResource ErpApproveButton}" Click="ClosePlan_Click" Margin="0,0,6,0"/>
                                <Button x:Name="EditPlanBtn" Content="✏️ تعديل" Style="{StaticResource ErpButton}" Click="EditPlan_Click" Margin="0,0,6,0"/>
                                <Button x:Name="DeletePlanBtn" Content="🗑️ حذف" Style="{StaticResource ErpDangerButton}" Click="DeletePlan_Click" Margin="0,0,6,0"/>
                                <Button x:Name="ForceCloseBtn" Content="⚠️ إقفال استثنائي" Style="{StaticResource ErpDangerButton}" Click="ForceClose_Click" Visibility="Collapsed" Margin="0,0,6,0"/>
                                <Button x:Name="ReopenBtn" Content="🔓 إعادة فتح بصلاحية خاصة" Style="{StaticResource ErpButton}" Click="Reopen_Click" Visibility="Collapsed"/>
                            </WrapPanel>
                            <TextBlock x:Name="BlockersBox" FontSize="11.5" Foreground="{StaticResource ErpDangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <TabControl Grid.Row="1">
                        <TabItem Header="📋 أوامر الإنتاج التابعة للخطة" FontSize="13">
                            <DataGrid x:Name="OrdersGrid" RowHeight="30" IsReadOnly="True"><DataGrid.Columns>
                                <DataGridTextColumn Header="أمر الإنتاج" Binding="{Binding OrderNumber}" Width="110"/><DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="الصنف" Binding="{Binding ProductNames}" Width="*"/><DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="90"/><DataGridTextColumn Header="الوردية" Binding="{Binding ShiftName}" Width="110"/><DataGridTextColumn Header="المخطط" Binding="{Binding Planned, StringFormat=N0}" Width="100"/><DataGridTextColumn Header="الفعلي" Binding="{Binding Produced, StringFormat=N0}" Width="100"/><DataGridTextColumn Header="المقفل" Binding="{Binding Closed, StringFormat=N0}" Width="100"/><DataGridTextColumn Header="الحالة" Binding="{Binding StateAr}" Width="90"/>
                            </DataGrid.Columns></DataGrid>
                        </TabItem>
                        <TabItem Header="👥 ملخص العملاء" FontSize="13"><DataGrid x:Name="CustomersGrid" RowHeight="30" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="العميل" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="المخطط" Binding="{Binding Planned, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="الفعلي" Binding="{Binding Produced, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="المقفل" Binding="{Binding Closed, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="المتبقي" Binding="{Binding Remaining, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="الحالة" Binding="{Binding StateAr}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
                        <TabItem Header="🏷️ ملخص الأصناف" FontSize="13"><DataGrid x:Name="ProductsGrid" RowHeight="30" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="المخطط" Binding="{Binding Planned, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="الفعلي" Binding="{Binding Produced, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="المقفل" Binding="{Binding Closed, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="المتبقي" Binding="{Binding Remaining, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="الحالة" Binding="{Binding StateAr}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
