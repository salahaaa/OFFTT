<UserControl x:Class="DatesErp.Desktop.Views.Screens.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{DynamicResource ThemeBackgroundBrush}">
    <!-- لوحة الدخول الأولى: ملخص تنفيذي واضح، بدون تكرار صدفة MainWindow القديمة. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,2,4,18">
            <!-- البطل البصري: هوية النظام + رسالة الترحيب + حالة الجلسة -->
            <Border CornerRadius="14" Padding="24,20" Margin="0,0,0,14" BorderThickness="1"
                    BorderBrush="#1E3A5F">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#123B35" Offset="0.62"/>
                        <GradientStop Color="#14532D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="لوحة التحكم التنفيذية" Foreground="#FDE68A" FontSize="12.5" FontWeight="Bold"/>
                        <TextBlock Text="مرحباً بك في نظام DateERP" Foreground="#F8FAFC" FontSize="28" FontWeight="ExtraBold" Margin="0,4,0,2"/>
                        <TextBlock Text="الشركة اليمنية لتعبئة وتصنيع التمور" Foreground="#FDE68A" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock Text="تابع سير الإنتاج والمخزون والجودة والتسليم من مكان واحد." Foreground="#CBD5E1" FontSize="13" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Border Background="#24FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                <TextBlock x:Name="DashUser" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12"/>
                            </Border>
                            <Border Background="#24FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                <TextBlock x:Name="DashDate" Foreground="#E2E8F0" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="220">
                        <Border Background="#18FFFFFF" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="10" Padding="14,11">
                            <StackPanel>
                                <TextBlock Text="حالة الجلسة" Foreground="#93C5FD" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="● النظام جاهز للعمل" Foreground="#86EFAC" FontSize="16" FontWeight="ExtraBold" Margin="0,3,0,0"/>
                                <TextBlock x:Name="FootDb" Foreground="#CBD5E1" FontSize="11" Margin="0,5,0,0"/>
                                <!-- يحتفظ به منطق الجلسة للتوافق، لكن لا نكرر اسم المستخدم في بطاقة الحالة. -->
                                <TextBlock x:Name="FootUser" Visibility="Collapsed"/>
                                <TextBlock Text="العام التشغيلي" Foreground="#94A3B8" FontSize="10.5" Margin="0,8,0,0"/>
                                <TextBlock x:Name="DashYear" Foreground="#FDE68A" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- وصول سريع للإدارات -->
            <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="0,0,18,0">
                        <TextBlock Text="الوصول السريع" Foreground="#0F172A" FontSize="14" FontWeight="ExtraBold"/>
                        <TextBlock Text="انتقل مباشرة إلى الإدارة المطلوبة" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <WrapPanel x:Name="DeptToolbar" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </DockPanel>
            </Border>

            <!-- مركز المهام -->
            <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right">
                            <TextBlock Text="مركز المهام والمتابعة" Foreground="#0F172A" FontSize="17" FontWeight="ExtraBold"/>
                            <TextBlock Text="الأرقام والتنبيهات التي تستحق انتباهك الآن" Foreground="#64748B" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Left" Background="#ECFDF5" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="7" Padding="10,5">
                            <TextBlock x:Name="TaskUserChip" Foreground="#166534" FontSize="11.5" FontWeight="Bold"/>
                        </Border>
                    </DockPanel>
                    <WrapPanel x:Name="TasksPanel"/>
                </StackPanel>
            </Border>

            <!-- الأعمال التي تحتاج إجراء مباشر -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="PendingGridBox" Grid.Column="0" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="خطط بانتظار الاعتماد" Foreground="#92400E" FontSize="13.5" FontWeight="ExtraBold"/>
                            <Button Content="اعتماد الخطة المحددة" Style="{StaticResource ErpApproveButton}" DockPanel.Dock="Left" Click="ApprovePlan_Click" Padding="12,5"/>
                        </DockPanel>
                        <DataGrid x:Name="PendingGrid" Height="150" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="29"
                                  GridLinesVisibility="All" HorizontalGridLinesBrush="#8CA0AC" VerticalGridLinesBrush="#8CA0AC"
                                  MouseDoubleClick="OpenPlan_Click">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الخطة" Binding="{Binding الرقم}" Width="110"/>
                                <DataGridTextColumn Header="العنوان والفترة" Binding="{Binding العنوان_والفترة}" Width="*"/>
                                <DataGridTextColumn Header="الأصناف" Binding="{Binding الأصناف}" Width="64"/>
                                <DataGridTextColumn Header="الوزن" Binding="{Binding إجمالي_الوزن}" Width="100"/>
                                <DataGridTextColumn Header="الكراتين" Binding="{Binding الكراتين}" Width="76"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding الحالة}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border x:Name="WhGridBox" Grid.Column="1" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="استلامات بانتظار إجراء المخزن" Foreground="#075985" FontSize="13.5" FontWeight="ExtraBold"/>
                            <Button Content="فتح شاشة الاستلام" Style="{StaticResource ErpButton}" DockPanel.Dock="Left" Click="OpenReceipt_Click" Padding="12,5"/>
                        </DockPanel>
                        <DataGrid x:Name="WhGrid" Height="150" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="29"
                                  GridLinesVisibility="All" HorizontalGridLinesBrush="#8CA0AC" VerticalGridLinesBrush="#8CA0AC"
                                  MouseDoubleClick="OpenReceipt_Click">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="أمر التسليم" Binding="{Binding رقم_أمر_التسليم}" Width="110"/>
                                <DataGridTextColumn Header="أمر الإنتاج" Binding="{Binding أمر_الإنتاج}" Width="105"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding تاريخ_التسليم}" Width="90"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding الإجمالي}" Width="95"/>
                                <DataGridTextColumn Header="المستلم" Binding="{Binding المستلم_سابقاً}" Width="100"/>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding المتبقي}" Width="90"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding الحالة}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- إدارات النظام -->
            <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="إدارات النظام" Foreground="#0F172A" FontSize="17" FontWeight="ExtraBold"/>
                    <TextBlock Text="اختر الإدارة لعرض شاشاتها وعملياتها" Foreground="#64748B" FontSize="11.5" Margin="0,2,0,10"/>
                    <StackPanel x:Name="DeptArea"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
