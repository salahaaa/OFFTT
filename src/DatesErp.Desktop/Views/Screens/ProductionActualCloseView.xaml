<UserControl x:Class="DatesErp.Desktop.Views.Screens.ProductionActualCloseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="430"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="إقفال الإنتاج" FontSize="25" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}"/>
                    <TextBlock Text="تسجيل الفعلي والتحقق من الفروقات قبل إنشاء أمر استلام المنتج التام" FontSize="12" Foreground="{StaticResource ErpMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="أمر الإنتاج" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="OrderBox" DisplayMemberPath="Label" SelectionChanged="Order_Changed" Height="34"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource ErpSurfaceBrush}" BorderBrush="{StaticResource BorderBrushStd}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2.2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource WhiteCard}" Padding="10" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="العملاء" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="CustChip" Text="—" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource WhiteCard}" Padding="10" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="الخطة" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanChip" Text="—" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource WhiteCard}" Padding="10" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="الوردية" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ShiftChip" Text="—" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource WhiteCard}" Padding="10" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="تاريخ الإنتاج" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="DateChip" Text="—" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" FontSize="20" Foreground="{StaticResource ErpWarnBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusLabel" Text="اختر أمراً من الأعلى." VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource WhiteCard}" Padding="0" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource ErpSurfaceBrush}" Padding="12,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="بنود الإنتاج والفعلي لكل عميل وصنف" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock DockPanel.Dock="Left" Text="أدخل الفعلي فقط؛ لا تُنشأ حركة مخزون هنا" Foreground="{StaticResource ErpMutedBrush}"/>
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="36" MinHeight="190" AlternatingRowBackground="{StaticResource ErpSurfaceBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource ErpLineBrush}" ColumnHeaderHeight="42">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="العميل" Binding="{Binding Customer}" IsReadOnly="True" Width="1.2*"/>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding Product}" IsReadOnly="True" Width="1.8*"/>
                            <DataGridTextColumn Header="المخطط" Binding="{Binding Planned}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="الفعلي" Binding="{Binding Actual, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Width="125"/>
                            <DataGridTextColumn Header="الفرق" Binding="{Binding Difference}" IsReadOnly="True" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                <Border x:Name="MeasurementsPanel" Grid.Column="0" Style="{StaticResource WhiteCard}" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="بيانات الإقفال" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="الخام المستهلك فعلياً (كجم)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RawBox" Height="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ساعات التوقف" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DowntimeBox" Height="34" Text="0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="سبب التوقف" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                        <TextBox x:Name="ReasonBox" Height="34"/>
                        <TextBlock Text="ملاحظات مدير الإنتاج" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                        <TextBox x:Name="NotesBox" Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ByProductsPanel" Grid.Column="1" Style="{StaticResource WhiteCard}" Padding="14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="المخرجات الثانوية" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DarkTitleBrush}"/>
                            <Button DockPanel.Dock="Left" Content="+ إضافة مخرج" Style="{StaticResource ErpButton}" Click="AddByProduct_Click"/>
                        </DockPanel>
                        <TextBlock Text="سجّل المخرجات الثانوية الفعلية إن وُجدت؛ تبقى حركة المخزون في مسار الاستلام." Foreground="{StaticResource ErpMutedBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <DataGrid x:Name="SecondaryGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="128" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="المخرج" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.ByProductDefinitions, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" SelectedItem="{Binding Definition, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" IsReadOnly="True" Width="95"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="125"/>
                                <DataGridTemplateColumn Header="" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="حذف" Click="RemoveByProduct_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
