<Window x:Class="DatesErp.Desktop.Views.LotPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختيار دفعة خام" Width="1180" Height="650"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="#F1F5F9" ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right">
                <TextBlock Text="اختيار دفعة خام" FontSize="22" FontWeight="Bold" Foreground="#163B46"/>
                <TextBlock Text="اختر المخزن والدفعة والكمية يدوياً — لا يوجد توزيع تلقائي" FontSize="12" Foreground="{StaticResource ErpMutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Left" Content="عرض الكل" Style="{StaticResource ErpButton}" Click="ShowAll_Click" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="الصنف الخام" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ProductFilterBox" DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="المخزن" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="WarehouseFilterBox" DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="حالة المعالجة" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TreatmentFilterBox" SelectionChanged="Filter_Changed"><ComboBoxItem Content="كل الحالات" Tag="all"/><ComboBoxItem Content="جاهز للتخطيط" Tag="ready"/><ComboBoxItem Content="تحت المعالجة" Tag="under"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="بحث برقم الدفعة / سند الاستلام" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SearchBox" Height="32" FontSize="13" Padding="6,4" TextChanged="SearchBox_TextChanged"/></StackPanel>
                <Button Grid.Column="4" Content="⟳ تحديث" Style="{StaticResource ErpPrimaryButton}" Click="Reload_Click" VerticalAlignment="Bottom" Padding="14,7"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource WhiteCard}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#E8F7F5" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Right" Text="الدفعات المتاحة" FontSize="14" FontWeight="Bold" Foreground="#0F766E"/><TextBlock x:Name="CountText" Text="—" Foreground="#335C67" Margin="12,0,0,0"/></DockPanel></Border>
                <DataGrid x:Name="LotsGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="36" FontSize="12.5" CanUserAddRows="False" MouseDoubleClick="LotsGrid_DoubleClick" SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#D6DEE5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاريخ الوصول" Binding="{Binding ArrivalDate, StringFormat=dd/MM/yyyy}" Width="105"/>
                        <DataGridTextColumn Header="الصنف الخام" Binding="{Binding ProductName}" Width="1.4*"/>
                        <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="1.1*"/>
                        <DataGridTextColumn Header="رقم سند الاستلام" Binding="{Binding ShipmentNo}" Width="1.2*"/>
                        <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding LotCode}" Width="1.1*"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="1.1*"/>
                        <DataGridTextColumn Header="الفعلي (كجم)" Binding="{Binding InitialQtyKg, StringFormat=N1}" Width="105"/>
                        <DataGridTextColumn Header="محجوز للخطط" Binding="{Binding ReservedQtyKg, StringFormat=N1}" Width="105"/>
                        <DataGridTextColumn Header="المتاح للتخطيط" Binding="{Binding RemainingKg, StringFormat=N1}" Width="115"/>
                        <DataGridTextColumn Header="تحت المعالجة" Binding="{Binding UnderTreatmentKg, StringFormat=N1}" Width="105"/>
                        <DataGridTextColumn Header="حالة المعالجة" Binding="{Binding TreatmentStatus}" Width="190"/>
                        <DataGridTextColumn Header="الوحدة" Binding="{Binding ReceiptUnit}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="FifoHint" Text="حدد صفاً ثم اضغط اختيار. قرار المخزن والدفعة والكمية يظل بيد مدير التخطيط." FontSize="11.5" Foreground="{StaticResource ErpMutedBrush}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="✅ اختيار" Style="{StaticResource ErpPrimaryButton}" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
                <Button Content="✖ إلغاء" Style="{StaticResource ErpButton}" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
