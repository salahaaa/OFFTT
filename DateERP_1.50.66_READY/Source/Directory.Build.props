<Project>
  <PropertyGroup>
    <!-- Audit direct AND transitive dependencies, including test/audit projects.
         Fail closed on an unavailable vulnerability feed or any advisory severity. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
